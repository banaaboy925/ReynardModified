+
+bool DefaultCodecPreferences::SendingH264SupportedStatic() {
+#ifdef XP_IOS
+  // Reynard's iOS build has no GMP/OpenH264 installation. Ask the WebRTC
+  // platform-codec adapter directly; on iOS this resolves to AppleVTEncoder.
+  const webrtc::SdpVideoFormat h264Format("H264");
+  return !MediaDataCodec::SupportsEncoderCodec(h264Format).isEmpty();
+#else
   return SoftwareH264EnabledStatic() || HardwareH264EnabledStatic();
+#endif
+}
+
+bool DefaultCodecPreferences::ReceivingH264SupportedStatic() {
+#ifdef XP_IOS
+  // Regular HTML media and WebRTC use different registration paths. Query the
+  // WebRTC MediaDataDecoder adapter so an existing AppleVTDecoder is exposed
+  // to RTCRtpReceiver.getCapabilities("video").
+  return !MediaDataCodec::SupportsDecoderCodec(
+              webrtc::VideoCodecType::kVideoCodecH264)
+              .isEmpty();
+#else
+  return SoftwareH264EnabledStatic() || HardwareH264EnabledStatic();
+#endif
 }
